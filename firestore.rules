rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'ADMIN' &&
         getUserData().isActive == true)
      );
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'STAFF' &&
         getUserData().isActive == true)
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // --- Users Collection ---
    // Staff can read their own profile or list colleagues; Admins can read all.
    // Only Admins can create user profiles (prevents self-registering Admin privilege escalation).
    // Staff can update self-service fields only (bio, phone, emergency contact, blood group, address, avatarUrl).
    // Role, staffId, department, designation, joiningDate, isActive, assignedTarget are strictly Admin-controlled and immutable for Staff.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'staffId', 'department', 'designation', 'joiningDate', 'isActive', 'assignedTarget', 'completedTarget'
        ])
      );
      allow delete: if isAdmin();
    }
    
    // --- Attendance Collection ---
    // Users can read and record their own check-in/out. Admins can view all attendance.
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutTime', 'remarks'])
      );
      allow delete: if isAdmin();
    }
    
    // --- Tasks Collection ---
    // Admins can create, delete, and fully update tasks.
    // Assigned staff can read their tasks and update progress, status, and staffNotes only.
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.assignedStaffId == request.auth.uid ||
        (resource.data.keys().hasAny(['assignedToStaffIds']) && resource.data.assignedToStaffIds.hasAny([request.auth.uid]))
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        (resource.data.assignedStaffId == request.auth.uid || 
         (resource.data.keys().hasAny(['assignedToStaffIds']) && resource.data.assignedToStaffIds.hasAny([request.auth.uid]))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'progressPercentage', 'completedUnits', 'staffNotes', 'lastUpdated'
        ])
      );
    }
    
    // --- Targets & Achievements ---
    // Admins control targets and achievements. Staff can read their own targets and all achievements.
    match /targets/{targetId} {
      allow read: if isAuthenticated() && (resource.data.staffId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // --- Announcements Collection ---
    // All authenticated users can view company announcements. Only Admins can publish or delete.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // --- Private Personal Notes ---
    // Strictly confidential: Only the note creator can read, create, update, or delete.
    match /notes/{noteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // --- GenzPluse Content ---
    // Content state transitions: DRAFT -> SUBMITTED (Staff) -> UNDER_REVIEW -> APPROVED / REJECTED (Admin).
    // Staff can create DRAFT or SUBMITTED, and edit only while DRAFT.
    // Only Admins can transition to UNDER_REVIEW, APPROVED, REJECTED and set adminReviewNotes.
    match /genzpluse_content/{contentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.creatorId == request.auth.uid && 
        request.resource.data.status in ['DRAFT', 'SUBMITTED'];
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.creatorId == request.auth.uid && 
        resource.data.status == 'DRAFT' &&
        request.resource.data.status in ['DRAFT', 'SUBMITTED'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminReviewNotes', 'creatorId'])
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        resource.data.creatorId == request.auth.uid && 
        resource.data.status == 'DRAFT'
      );
    }
    
    // --- Leave Requests ---
    // Staff can create PENDING leave requests for themselves.
    // Only Admin can transition status to APPROVED or REJECTED.
    match /leave_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.staffId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.staffId == request.auth.uid && 
        request.resource.data.status == 'PENDING';
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.staffId == request.auth.uid && 
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'PENDING'
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        resource.data.staffId == request.auth.uid && 
        resource.data.status == 'PENDING'
      );
    }
    
    // --- Problem Reports ---
    // Staff can report problems in PENDING state. Only Admins can update status, assign, or close.
    match /problem_reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.staffId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.staffId == request.auth.uid && 
        request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // --- Notifications Collection ---
    // Users can read notifications directed to them or broadcast notifications.
    // Recipients can mark notifications as read. Only Admins can issue notifications.
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid || 
        resource.data.isBroadcast == true || 
        isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.targetUserId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.targetUserId == request.auth.uid
      );
    }
    
    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

